#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/* Mouse/Scroll */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200
#include <dt-bindings/zmk/pointing.h>

#include <dt-bindings/zmk/rgb.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_cond: adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        rot_kp: rot_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        rot_msc: rot_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
        };

        rot_mmv: rot_mmv {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&mmv>, <&mmv>;
        };

        /* “transparent” für Sensoren geht nicht mit &trans.
         * Stattdessen: echter No-Op für den rechten Encoder auf Upper */
        enc_noop: enc_noop {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&none>, <&none>;
        };
    };

    /* Optional: damit’s sofort reagiert */
    &msc { time-to-max-speed-ms = <0>; };
    &mmv { time-to-max-speed-ms = <0>; };

    keymap {
        compatible = "zmk,keymap";

        /***********************
         * LAYER 0: Base
         ***********************/
        base_layer: base {
            bindings = <
                &kp ESC     &kp N1     &kp N2     &kp N3     &kp N4     &kp N5                         &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &kp BSPC
                &kp TAB     &kp Q      &kp W      &kp E      &kp R      &kp T                          &kp Z      &kp U      &kp I      &kp O      &kp P      &kp LBKT
                &kp LCTRL   &kp A      &kp S      &kp D      &kp F      &kp G                          &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp RBKT
                &kp LSHFT   &kp Y      &kp X      &kp C      &kp V      &kp B      &mkp MB1    &mkp MB2     &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
                                    &kp LALT   &kp LGUI   &mo 1     &kp SPACE      &kp RET     &mo 2      &kp DEL    &kp RALT
            >;

            /* !!! WICHTIG: Scroll = SCRL_* (nicht MOVE_*) */
            sensor-bindings = <
                &rot_msc SCRL_UP    SCRL_DOWN     /* linker Encoder = vertikal scroll */
                &rot_msc SCRL_RIGHT SCRL_LEFT     /* rechter Encoder = horizontal scroll */
            >;
        };

        /***********************
         * LAYER 1: Lower
         ***********************/
        lower_layer: lower {
            bindings = <
                &trans      &trans      &trans      &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP                 &trans     &kp KP_N7      &kp KP_N8      &kp KP_N9       &kp KP_PLUS      &kp APOS
                &trans      &trans      &trans      &trans        &trans        &trans                      &trans     &kp KP_N4      &kp KP_N5      &kp KP_N6       &kp KP_MINUS     &kp GRAVE
                &trans      &trans      &trans      &trans        &trans        &trans                      &trans     &kp KP_N1      &kp KP_N2      &kp KP_N3       &kp KP_MULTIPLY  &trans
                &kp CAPS    &trans      &trans      &trans        &trans        &trans        &mkp MB1 &mkp MB2     &trans     &kp KP_N0      &kp KP_EQUAL    &kp KP_DOT       &kp KP_DIVIDE    &kp BSLH
                                        &trans      &trans      &trans         &trans        &trans       &trans      &trans         &trans
            >;

            sensor-bindings = <
                &rot_mmv MOVE_RIGHT MOVE_LEFT      /* linker Encoder = Maus horizontal */
                &rot_mmv MOVE_DOWN  MOVE_UP        /* rechter Encoder = Maus vertikal */
            >;
        };

        /***********************
         * LAYER 2: Upper
         ***********************/
        upper_layer: upper {
            bindings = <
                &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6                         &kp F7     &kp F8     &kp F9      &kp F10     &kp F11     &kp F12
                &trans      &trans      &kp UP      &trans      &trans      &trans                        &trans     &trans     &trans      &trans      &trans      &kp PSCRN
                &trans      &kp LEFT    &kp DOWN    &kp RIGHT   &trans      &trans                        &trans     &trans     &trans      &trans      &trans      &trans
                &trans      &trans      &trans      &trans      &trans      &trans        &kp C_MUTE  &trans      &trans     &trans     &trans      &trans      &trans      &trans
                                        &trans      &trans      &trans       &trans        &trans       &trans      &trans     &trans
            >;

            /* Links Volume, rechts "nix" */
            sensor-bindings = <
                &rot_kp C_VOL_UP C_VOL_DN
                &enc_noop
            >;

            /* Klick-Mute:
             * Das musst du über den Encoder-„Taster“ als normales Key-Binding mappen
             * (also dort, wo du z.B. &mkp MB1/MB2 im Grid hast). */
        };

        /***********************
         * LAYER 3: Adjust
         ***********************/
        adjust_layer: adjust {
            bindings = <
                &bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4        &trans  &trans  &trans  &trans  &trans  &trans
                &ext_power EP_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_SAI   &rgb_ug RGB_HUI  &rgb_ug RGB_EFF  &rgb_ug RGB_SPI     &trans  &trans  &trans  &trans  &trans  &trans
                &trans             &rgb_ug RGB_BRD  &rgb_ug RGB_SAD   &rgb_ug RGB_HUD  &trans           &rgb_ug RGB_SPD     &trans  &trans  &trans  &trans  &trans  &trans
                &trans             &trans           &trans           &trans           &trans           &trans               &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                     &trans         &trans           &trans           &trans               &trans  &trans  &trans  &trans
            >;
        };
    };
};
