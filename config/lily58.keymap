#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    // Activate ADJUST layer by pressing raise and lower
    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    /*
     * US-International Umlaut Makros:
     *   ä = " + a
     *   ö = " + o
     *   ü = " + u
     *   Ä/Ö/Ü entsprechend mit Shift
     *   ß = AltGr+S (RALT+S)  (je nach OS/Layout ggf. anpassen)
     */
    macros {
        de_ae: de_ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp A>;
        };
        de_oe: de_oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp O>;
        };
        de_ue: de_ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp U>;
        };

        de_AE: de_AE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp LSFT &kp A &kp LSFT>;
        };
        de_OE: de_OE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp LSFT &kp O &kp LSFT>;
        };
        de_UE: de_UE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp LSFT &kp U &kp LSFT>;
        };

        de_ss: de_ss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RALT &kp S>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /***********************
         * LAYER 0: Default
         ***********************/
        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |  4  |  5  |                   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // |  TAB  |  Q  |  W  |  E  |  R  |  T  |                   |  Y  |  U  |  I  |  O  |  P  |  {   |
            // | CTRL  |  A  |  S  |  D  |  F  |  G  |                   |  H  |  J  |  K  |  L  |  ;  |  }   |
            // | SHIFT |  Y  |  X  |  C  |  V  |  B  | ENC_L |  ENC_R     |  N  |  M  |  ,  |  .  |  /  |SHIFT|
            //                    | ALT | GUI |LOWER| SPACE |   ENTER    |UPPER| DEL | ALT |
            bindings = <
                &kp ESC    &kp N1  &kp N2   &kp N3   &kp N4   &kp N5                                  &kp N6   &kp N7   &kp N8   &kp N9   &kp N0   &kp BSPC
                &kp TAB    &kp Q   &kp W    &kp E    &kp R    &kp T                                   &kp Y    &kp U    &kp I    &kp O    &kp P    &kp LBKT
                &kp LCTRL  &kp A   &kp S    &kp D    &kp F    &kp G                                   &kp H    &kp J    &kp K    &kp L    &kp SEMI &kp RBKT
                &kp LSHFT  &kp Y   &kp X    &kp C    &kp V    &kp B    &kp MB1        &kp MB1         &kp N    &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                                   &kp LALT &kp LGUI &mo 1    &kp SPACE &kp RET       &mo 2           &kp DEL  &kp RALT
            >;

            /*
             * Sensor order = Encoder order (wie dein Board es liefert)
             *   Sensor 0 (links): Maus horizontal (rechts/links)
             *   Sensor 1 (rechts): Maus vertikal (runter/hoch)
             */
            sensor-bindings = <
                &inc_dec_kp C_MS_RIGHT C_MS_LEFT
                &inc_dec_kp C_MS_DOWN  C_MS_UP
            >;
        };

        /***********************
         * LAYER 1: Lower
         * + Umlaute (US-International via Makros)
         ***********************/
        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |      |      |      |      | MUTE | VOL- |              |      |  7  |  8  |  9  |  +  |  .  |
            // |      |  ä   |  ö   |  ü   |      | VOL+ |              |      |  4  |  5  |  6  |  -  |  ,  |
            // |      |  Ä   |  Ö   |  Ü   |      |      |              |      |  1  |  2  |  3  |  *  |     |
            // | CAPS |  ß   |      |      |      |      | ENC_L|ENC_R  |      |  0  |  =  |     |  /  |  \  |
            //                    |      |      |      |      |        |      |      |      |
            bindings = <
                &trans     &trans     &trans     &trans       &kp C_MUTE &kp C_VOL_DN                              &trans     &kp KP_N7  &kp KP_N8   &kp KP_N9   &kp KP_PLUS  &kp KP_DOT
                &trans     &de_ae     &de_oe     &de_ue       &trans     &kp C_VOL_UP                              &trans     &kp KP_N4  &kp KP_N5   &kp KP_N6   &kp KP_MINUS &kp KP_COMMA
                &trans     &de_AE     &de_OE     &de_UE       &trans     &trans                                   &trans     &kp KP_N1  &kp KP_N2   &kp KP_N3   &kp KP_ASTER &trans
                &kp CAPS   &de_ss     &trans     &trans       &trans     &trans    &kp MB1          &kp MB1        &trans     &kp KP_N0  &kp KP_EQUAL &trans       &kp KP_SLASH &kp KP_BSLH
                                   &trans     &trans     &trans       &trans     &trans            &trans         &trans     &trans
            >;

            /*
             * Lower: lasse Encoder wie Default (Maus bewegen)
             * (Wenn du willst, kann Lower z.B. Scrollen werden.)
             */
            sensor-bindings = <
                &inc_dec_kp C_MS_RIGHT C_MS_LEFT
                &inc_dec_kp C_MS_DOWN  C_MS_UP
            >;
        };

        /***********************
         * LAYER 2: Upper
         * Encoder = Lautstärke
         ***********************/
        upper_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |              |  F7  |  F8  |  F9  | F10 | F11 | F12 |
            // |      |      |  UP  |      |      |      |              |      |      |      |     |     |PrSc |
            // |      | LEFT | DOWN |RIGHT |      |      |              |      |      |      |     |     |     |
            // |      |      |      |      |      |      | ENC_L|ENC_R  |      |      |      |     |     |     |
            //                    |      |      |      |      |        |      |      |      |
            bindings = <
                &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6                                  &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
                &trans     &trans     &kp UP     &trans     &trans     &trans                                   &trans     &trans     &trans     &trans     &trans     &kp PSCRN
                &trans     &kp LEFT   &kp DOWN   &kp RIGHT  &trans     &trans                                   &trans     &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans     &trans   &kp MB1          &kp MB1        &trans     &trans     &trans     &trans     &trans     &trans
                                   &trans     &trans     &trans     &trans     &trans            &trans         &trans     &trans
            >;

            /*
             * Upper: beide Encoder regeln Lautstärke
             *   Sensor 0 (links): Vol+ / Vol-
             *   Sensor 1 (rechts): Vol+ / Vol-
             */
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        /***********************
         * LAYER 3: Config (Adjust)
         ***********************/
        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1  |  BT2  |  BT3  |  BT4  |  BT5  |       |      |      |      |      |      |      |
            // | EXTPWR | RGB-  | RGB+  | SAT-  | SAT+  | EFF   |       |      |      |      |      |      |      |
            // |        | BRI-  | BRI+  |       |       |       |       |      |      |      |      |      |      |
            // |        |       |       |       |       |       |       |      |      |      |      |      |      |
            //                     |     |      |       |      |       |       |      |      |      |      |
            bindings = <
                &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &trans &trans &trans &trans &trans &trans
                &ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &trans &trans &trans &trans &trans &trans
                &trans            &rgb_ug RGB_BRD &rgb_ug RGB_BRI &trans          &trans          &trans                                   &trans &trans &trans &trans &trans &trans
                &trans            &trans          &trans          &trans          &trans          &trans            &trans &trans         &trans &trans &trans &trans &trans &trans
                                   &trans         &trans         &trans         &trans          &trans            &trans         &trans &trans &trans &trans
            >;

            /* Config: Encoder auf Lautstärke gelassen (praktisch). */
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
        extra5 { status = "reserved"; };
    };
};
