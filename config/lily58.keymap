#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    /* Tri-layer: ADJUST aktiv wenn LOWER + UPPER */

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };


    behaviors {
        enc_mouse_h: enc_mouse_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            /* CW, CCW */

            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };

        enc_mouse_v: enc_mouse_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            /* CW, CCW */

            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /***********************
         * LAYER 0: Default
         * Encoder drehen: Maus bewegen
         * Encoder drücken: Mausklick
         ***********************/

        base {
            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                          &kp N6  &kp N7   &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                           &kp Y   &kp U    &kp I      &kp O    &kp P     &kp LBKT
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                           &kp H   &kp J    &kp K      &kp L    &kp SEMI  &kp RBKT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B   &mkp LCLK    &mkp LCLK  &kp N   &kp M    &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &kp RET    &mo 2   &kp DEL  &kp RALT
            >;

            /* 2 Encoder: 1) horizontal  2) vertikal */

            sensor-bindings = <&enc_mouse_h &enc_mouse_v>;
        };

        /***********************
         * LAYER 1: Lower
         * (hier: gleiche Encoder-Mausbewegung wie Base)
         ***********************/

        lower {
            bindings = <
&trans    &trans  &trans  &kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP                          &trans  &kp KP_N7  &kp KP_N8     &kp KP_N9   &kp KP_PLUS   &kp APOS
&trans    &trans  &trans  &trans      &trans        &trans                                &trans  &kp KP_N4  &kp KP_N5     &kp KP_N6   &kp KP_MINUS  &kp GRAVE
&trans    &trans  &trans  &trans      &trans        &trans                                &trans  &kp KP_N1  &kp KP_N2     &kp KP_N3   &kp STAR      &trans
&kp CAPS  &trans  &trans  &trans      &trans        &trans        &mkp LCLK    &mkp LCLK  &trans  &kp KP_N0  &kp KP_EQUAL  &kp KP_DOT  &kp KP_SLASH  &kp BSLH
                          &trans      &trans        &trans        &trans       &trans     &trans  &trans     &trans
            >;

            sensor-bindings = <&enc_mouse_h &enc_mouse_v>;
        };

        /***********************
         * LAYER 2: Upper
         * Encoder = Lautstaerke (beide gleich)
         ***********************/

        upper {
            bindings = <
&kp F1  &kp F2    &kp F3    &kp F4     &kp F5  &kp F6                          &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans    &kp UP    &trans     &trans  &trans                          &trans  &trans  &trans  &trans   &trans   &kp PSCRN
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans                          &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans    &trans    &trans     &trans  &trans  &mkp LCLK    &mkp LCLK  &trans  &trans  &trans  &trans   &trans   &trans
                            &trans     &trans  &trans  &trans       &trans     &trans  &trans  &trans
            >;

            /* 2 Encoder, jeweils CW/CCW */

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        /***********************
         * LAYER 3: Adjust
         ***********************/

        adjust {
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                                &trans  &trans  &trans  &trans  &trans  &trans
&ext_power EP_TOG  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                             &trans  &trans  &trans  &trans  &trans  &trans
&trans             &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans           &trans           &trans           &trans           &trans           &rgb_ug RGB_TOG    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                                                     &trans           &trans           &trans           &trans             &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
